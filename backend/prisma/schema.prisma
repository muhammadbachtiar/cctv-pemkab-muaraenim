generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String   @id @default(uuid()) @db.VarChar(36)
  username      String   @unique @db.VarChar(191)
  passwordHash  String   @db.Text
  fullName      String?  @db.VarChar(191)
  roleId        String   @db.VarChar(36)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role          Role     @relation(fields: [roleId], references: [id])
  cameraAccess  UserCameraAccess[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(191)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  users       User[]
  // MariaDB/MySQL tidak mendukung array, gunakan Json sebagai gantinya
  // Format: ["camera:create", "camera:read", ...]
  permissions Json     @default("[]")

  @@map("roles")
}

model Camera {
  id              String   @id @default(uuid()) @db.VarChar(36)
  name            String   @db.VarChar(191)
  path            String   @unique @db.VarChar(191)
  rtspUrl         String   @db.Text
  locationName    String?  @db.VarChar(191)
  latitude        Float?
  longitude       Float?

  isActive        Boolean  @default(true)
  isPublic        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userAccess      UserCameraAccess[]

  @@map("cameras")
}

model UserCameraAccess {
  id         String  @id @default(uuid()) @db.VarChar(36)
  userId     String  @db.VarChar(36)
  cameraId   String  @db.VarChar(36)
  canView    Boolean @default(true)

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  camera     Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([userId, cameraId])
  @@map("user_camera_access")
}
